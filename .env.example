# HELIORA — Root Environment Configuration Reference
# See apps/web/.env.example and apps/api/.env.example for application-specific configurations.

# Local PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=heliora
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/heliora

# API
API_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-secret-key-for-development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── LLM (Google Gemini — ADR-009 / Architecture §41) ─────────────────────────
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
# Sistem mendukung fallback deterministik otomatis jika key tidak diisi (BR-LLM-000).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=10
