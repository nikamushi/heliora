# HELIORA API — Environment Variables
# Copy this file to .env and fill in the values.

# Application
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
API_V1_PREFIX=/api/v1

# Local PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/heliora

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# LLM (placeholder — provider not locked per Architecture §41)
# LLM_PROVIDER=
# LLM_API_KEY=

# RAG (placeholder — vector DB not locked per Architecture §41)
# RAG_CONFIGURATION=
# MODEL_PATH=
