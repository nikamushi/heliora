# HELIORA API — Environment Variables
# Copy this file to .env and fill in the values.

# Application
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
API_V1_PREFIX=/api/v1

# Local PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/heliora

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Supabase Auth / JWKS Verifier (ADR-011 / Issue #18)
# WAJIB diisi agar verify_token() memverifikasi Bearer JWT Supabase lewat JWKS.
# Tanpa SUPABASE_JWKS_URL, token Supabase ditolak (fallback HS256 lokal).
# DATABASE_URL di atas harus menunjuk ke Postgres Supabase yang sama, karena
# public.users diisi oleh trigger handle_new_user() (lihat supabase/schema.sql).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

# LLM (Gemini — ADR-009 implementation decision per Architecture §41)
# Copy your key from https://aistudio.google.com/api-keys into .env (gitignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=10

# RAG (placeholder — vector DB not locked per Architecture §41)
# RAG_CONFIGURATION=
# MODEL_PATH=
