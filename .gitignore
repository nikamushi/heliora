# =============================================================================
# Heliora monorepo — root .gitignore (shared ignore policy)
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js / Next.js
# -----------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
.nx/
*.tsbuildinfo

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager caches (not project source)
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# -----------------------------------------------------------------------------
# Python / FastAPI
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.pyre/
.dmypy.json
dmypy.json

# Coverage (Python)
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Packaging / build artifacts
*.egg-info/
*.egg
.eggs/
wheels/
share/python-wheels/
pip-wheel-metadata/
MANIFEST
*.manifest

# -----------------------------------------------------------------------------
# ML artifacts
# -----------------------------------------------------------------------------
.ipynb_checkpoints/

# Model binaries / artifacts
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.keras
*.safetensors
*.joblib

# Training / experiment output
runs/
wandb/
mlruns/
checkpoints/
artifacts/

# Local / downloaded / raw dataset locations only
# (do NOT globally ignore *.csv, *.json, *.parquet, etc.)
data/raw/
data/downloads/
data/tmp/

# CDC BRFSS raw CSV datasets
**/*BRFSS*.csv
**/*brfss*.csv

# -----------------------------------------------------------------------------
# Environment and secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template

secret/
secrets/
credentials/
credentials.*

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx

# -----------------------------------------------------------------------------
# Testing / temporary artifacts
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
*.lcov

tmp/
temp/
.tmp/
*.tmp
*.temp
*.log

# -----------------------------------------------------------------------------
# IDE / OS artifacts
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.iml
*~
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# -----------------------------------------------------------------------------
# AI / Agent artifacts (NOT project docs/ or monorepo ai/)
# -----------------------------------------------------------------------------
AGENTS.md
CLAUDE.md
GEMINI.md
COPILOT.md
.cursor/
.claude/
.gemini/
.agent/
.agents/
skills/
.skill/
.agent-skills/
.ai/
.ai-context/
.ai-cache/

# -----------------------------------------------------------------------------
# Generated / runtime files
# -----------------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.pid
*.sqlite
*.sqlite3
