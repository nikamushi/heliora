# Copy to infra/compose/.env on the VPS. Never commit the real file.

# ── Images ───────────────────────────────────────────────────────
IMAGE_PREFIX=ghcr.io/nikamushi
IMAGE_TAG=latest

# ── Public hosts (Caddy terminates TLS for API; frontend is on Vercel) ─
DOMAIN=heliora.software
API_DOMAIN=api.heliora.software

# ── API runtime ──────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/heliora
CORS_ORIGINS=["https://heliora.software","https://heliora-web-snowy.vercel.app"]

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=10
# Cloudflare Worker proxy (required when VPS egress is blocked by Gemini geo policy)
GEMINI_PROXY_URL=
GEMINI_PROXY_SECRET=

# ── Web runtime ──────────────────────────────────────────────────
# NEXT_PUBLIC_* values are inlined at image build time; they are listed here
# only as a reference for the deploy workflow build arguments.
NEXT_PUBLIC_API_URL=https://api.heliora.software
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
